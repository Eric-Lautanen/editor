        </Component>
        <Component Id="ExtSh" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.sh\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <!-- Dotfiles are extensions as far as the shell is concerned:
             `.gitignore` is `Software\Classes\.gitignore` even though
             `Path::extension()` calls it nothing. Same OpenWithProgids shape
             as every other type; see `DOTFILES` in core::file_kind. -->
        <Component Id="ExtGitignore" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.gitignore\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtGitattributes" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.gitattributes\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtGitmodules" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.gitmodules\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtEditorconfig" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.editorconfig\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtDockerignore" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.dockerignore\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtNpmrc" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.npmrc\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtNvmrc" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.nvmrc\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtPrettierrc" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.prettierrc\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- The Desktop shortcut. Same per-user KeyPath trick as the Start menu
         component below (an HKCU value, since a per-user component's key path
         cannot be a machine-context shortcut), and the .lnk itself is removed
         with the component on uninstall. The Desktop *folder* is not ours, so
         there is deliberately no RemoveFolder here. -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut
            Id="EditorDesktopShortcut"
            Name="Editor"
            Description="Editor"
            Target="[INSTALLFOLDER]editor.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="editor.ico" />
        <RegistryValue Root="HKCU" Key="Software\Eric-Lautanen\Editor" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Editor">
        <!-- Shortcuts need a KeyPath of their own; an HKCU registry value is
             the per-user MSI-correct one (a shortcut file would need machine
             context). Removing the value plus the folder makes uninstall
             leave nothing behind. -->
        <Component Id="StartMenuShortcut" Guid="*">
          <!-- ASCII, like the dialog text: Windows Installer writes a shortcut
               description through the shell, which turned the em dash this
               once carried into a plain hyphen anyway (checked by reading both
               .lnk files after a real install). -->
          <Shortcut
              Id="EditorShortcut"
              Name="Editor"
              Description="Editor"
              Target="[INSTALLFOLDER]editor.exe"
              WorkingDirectory="INSTALLFOLDER"
              Icon="editor.ico" />
          <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Eric-Lautanen\Editor" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
