<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows installer for Editor, built by `.github/workflows/release.yml` with
  `wix build ... -d Version=$(version) packaging/windows/editor.wxs`.

  Design points:

  * `Scope="perUser"` together with `ALLUSERS=2` and `MSIINSTALLPERUSER=1`:
    a standard user installs the whole product under their own profile
    (`PerUserProgramFilesFolder` resolves to `%LOCALAPPDATA%\Programs` in
    per-user context, see Microsoft's Single Package Authoring) with no UAC
    prompt, the same promise the portable install flag makes. Windows
    Installer falls back to the machine-wide registration when an
    administrator runs it from an already-elevated session; the payload path
    is unaffected. (XML comments cannot contain double hyphens, so CLI flags
    are written as e.g. the “update flag”.)
  * One fixed `UpgradeCode` is the upgrade identity and the `Upgrade` rows are
    written by hand below, with an INCLUSIVE upper bound: reinstalling the same
    version replaces the previous install (Windows Installer removes it inside
    the same transaction, which is how the update command can just hand the
    user an MSI). WiX's `<MajorUpgrade>` element cannot express that - its
    VersionMax is exclusive - which is what put three "Editor 0.1.0" entries in
    one machine's Add/Remove Programs.
  * The file associations mirror `platform/install.rs`'s portable install
    flag: the same `Editor.Document` ProgID and per-extension
    `OpenWithProgids` values under HKCU. Running the MSI after a portable
    install (or vice versa) writes identical data, so there is no clash to
    fail on.
  * The extension list below must track `core::file_kind::EXTENSIONS`: the
    `packaging_manifests_claim_exactly_the_supported_extensions` test in
    `src/core/file_kind.rs` reads this file and fails if the two drift apart,
    so edit either one and let the test tell you which side is short.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Editor"
      Manufacturer="Eric-Lautanen"
      Version="$(var.Version)"
      UpgradeCode="7C61E9D4-33C2-4FA9-9BA4-0D6A57457F09"
      UpgradeStrategy="majorUpgrade"
      Scope="perUser"
      Language="1033"
      Codepage="65001"
      Compressed="yes">

    <!-- Embed the payload cabinet INTO the msi: without `EmbedCab` WiX
         writes a sibling cab1.cab and the installer dies with "Source file
         not found" when run from anywhere but the build directory
         (observed: Downloads). `Package@Compressed=.names` is default-on and
         NOT enough; the MediaTemplate switch is what embeds. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- `UpgradeCode` is the stable upgrade identity: never regenerate it (a
         new GUID here would make MSI installs sit next to the old one
         instead of replacing it). ProductCode differs per build by WiX
         default, which is exactly what major upgrades want. -->
    <!-- The upgrade detection is spelled out instead of using `<MajorUpgrade>`:
         that element's VersionMax is EXCLUSIVE, so reinstalling the same
         version (a republished build, a plain re-run) matched nothing and every
         install added another Add/Remove Programs entry beside the old one
         instead of replacing it. The range below is inclusive at the top, so
         any build at or below this one is removed first; a genuinely newer
         install is only detected, and the launch condition says so rather than
         silently downgrading. -->
    <Upgrade Id="7C61E9D4-33C2-4FA9-9BA4-0D6A57457F09">
      <UpgradeVersion
          Minimum="0.0.0"
          IncludeMinimum="yes"
          Maximum="$(var.Version)"
          IncludeMaximum="yes"
          OnlyDetect="no"
          Property="WIX_UPGRADE_DETECTED" />
      <UpgradeVersion
          Minimum="$(var.Version)"
          IncludeMinimum="no"
          OnlyDetect="yes"
          Property="WIX_NEWER_VERSION_DETECTED" />
    </Upgrade>
    <Property Id="WIX_UPGRADE_DETECTED" Secure="yes" />
    <Property Id="WIX_NEWER_VERSION_DETECTED" Secure="yes" />
    <Launch
        Condition="NOT WIX_NEWER_VERSION_DETECTED"
        Message="A newer version of Editor is already installed." />
    <!-- Uninstall runs the installed exe's own uninstall flag before its
         files go: that removes the file associations this package wrote and,
         the part Windows Installer cannot see, the staged update downloads
         under %TEMP% (editor-update-<tag> directories the updater created).
         An uninstall that leaves megabytes of installer behind is not an
         uninstall. `Return="ignore"` so a removed or locked exe never blocks
         the removal itself, and REMOVE=ALL keeps it to a real uninstall: a
         repair or a component update must not run the uninstall path. -->
    <CustomAction
        Id="UnregisterOnUninstall"
        FileRef="EditorExe"
        ExeCommand="--uninstall"
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />
    <!-- This package deliberately launches nothing. An earlier revision did,
         from a deferred `asyncNoWait` custom action before `InstallFinalize`,
         and that caused two failures that are worth writing down so the action
         does not come back:
           1. A major upgrade runs the execute sequence more than once (the
              old product's removal and the new product's install), so the
              action fired twice. The second Editor found the first one's
              single-instance mutex and hung instead of coming up.
           2. A process started *inside* the transaction is still holding the
              exe when the install finishes finalising; Windows Installer sees a
              file in use and schedules a restart. On this machine that ended in
              the box rebooting itself, which an app update must never do.
         Restart Manager is not the answer either: it closes the app whose files
         it replaces and does not reopen it. So the updater owns the relaunch —
         `src/update.rs` runs msiexec and starts the new build in one `cmd` line
         *after* the install exits, exactly once, with `REBOOT=ReallySuppress`
         so no update can ever ask for a reboot. A wizard install and a scripted
         `/qn` deploy install quietly and open nothing, which is what they want. -->
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize" />
      <Custom Action="UnregisterOnUninstall" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- Per-user preferred, stated rather than implied: ALLUSERS=2 with
         MSIINSTALLPERUSER=1 means a standard user installs the whole product
         (files, Start-menu entry, associations, Add/Remove Programs row) inside
         their own profile with no UAC prompt. Windows Installer falls back to
         the machine-wide registration when an administrator runs it from an
         already-elevated session, which is its documented rule for this
         combination; the payload still lands under the per-user
         ProgramFilesFolder because that is what directs the files. -->
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />

    <Icon Id="editor.ico" SourceFile="$(var.Icon)" />
    <!-- The header icon the dialogs draw. MSI's Icon control renders the icon's
         FIRST frame stretched to the control's pixel size, so this asset leads
         with the 48px frame - exactly the size a 32x32-dialog-unit control is
         at 100% scaling. Feeding it assets/icon.ico (whose first frame is
         16px) is what made the old icon a blurry block. -->
    <Icon Id="editor_setup.ico" SourceFile="$(var.DialogIcon)" />
    <Binary Id="editor_setup.ico" SourceFile="$(var.DialogIcon)" />
    <Property Id="ARPPRODUCTICON" Value="editor.ico" />
    <!-- Sensible defaults for ARP metadata. -->
    <Property Id="ARPNOMODIFY" Value="1" /> <!-- replace-don't-tweak: updates come as new MSIs -->

    <!-- No System Restore point for this install: `MSIFASTINSTALL` bit 1 is
         Microsoft's documented switch for it, and Microsoft's own
         single-package-authoring example uses the same value.

         This is the "installer sits there doing nothing" report. Windows
         Installer snapshots the system before copying files whenever the
         product is not already installed in that context, and on a real
         machine that silent call is the whole wait: a fresh install of this
         package measured 13.4 s, 12.4 s of it inside `SRSetRestorePoint`
         (the log goes straight from "Calling SRSetRestorePoint API ...
         szDescription: \"Installed Editor\"" to "The call to
         SRSetRestorePoint API succeeded", with the progress bar on screen the
         whole time). Reinstalls over an existing version skip it, which is
         why the stall looks intermittent.

         Editor installs one exe and a set of HKCU rows; a restore point buys
         back nothing that re-running the MSI or uninstalling does not, and
         the auto-updater installs often enough that 12 s per version would be
         the normal experience. Set this back to 0 if you would rather keep
         the checkpoint. -->
    <Property Id="MSIFASTINSTALL" Value="1" />

    <Feature Id="Main" Title="Editor" Description="The editor and this installer's choices." Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="ProgIdRegistry" />
      <!-- The Desktop shortcut is its own feature so the checkbox can turn
           it off; its Level is 1, so a silent install (the auto-updater's
           `msiexec /passive`) gets it too. The Start menu entry is not
           optional - it is how an app is expected to be reachable after
           installing. -->
      <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut" Description="A shortcut to Editor on the Desktop." Level="1" AllowAdvertise="no">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
      <!-- The association comps nest under two checkbox-driven subfeatures;
           their state is set by the one-page dialog below: unchecking a
           checkbox removes that whole group (its components stay installed
           forever-silent installs run no UI, so both groups default on). -->
      <Feature Id="DocumentTypes" Title="Associate document and config files" Description="md, markdown, json, jsonl, ndjson, txt, log, csv, tsv, yaml, yml, toml, ini, cfg, conf in your Open-with menu." Level="1" AllowAdvertise="no">
        <ComponentRef Id="ExtMd" />
        <ComponentRef Id="ExtMarkdown" />
        <ComponentRef Id="ExtJson" />
        <ComponentRef Id="ExtJsonl" />
        <ComponentRef Id="ExtNdjson" />
        <ComponentRef Id="ExtTxt" />
        <ComponentRef Id="ExtLog" />
        <ComponentRef Id="ExtCsv" />
        <ComponentRef Id="ExtTsv" />
        <ComponentRef Id="ExtYaml" />
        <ComponentRef Id="ExtYml" />
        <ComponentRef Id="ExtToml" />
        <ComponentRef Id="ExtIni" />
        <ComponentRef Id="ExtCfg" />
        <ComponentRef Id="ExtConf" />
      </Feature>
      <Feature Id="CodeTypes" Title="Associate code files" Description="rs, py, js, ts, c, h, cpp, hpp, cs, java, go, rb, php, css, html, xml, sh in your Open-with menu." Level="1" AllowAdvertise="no">
        <ComponentRef Id="ExtRs" />
        <ComponentRef Id="ExtPy" />
        <ComponentRef Id="ExtJs" />
        <ComponentRef Id="ExtTs" />
        <ComponentRef Id="ExtC" />
        <ComponentRef Id="ExtH" />
        <ComponentRef Id="ExtCpp" />
        <ComponentRef Id="ExtHpp" />
        <ComponentRef Id="ExtCs" />
        <ComponentRef Id="ExtJava" />
        <ComponentRef Id="ExtGo" />
        <ComponentRef Id="ExtRb" />
        <ComponentRef Id="ExtPhp" />
        <ComponentRef Id="ExtCss" />
        <ComponentRef Id="ExtHtml" />
        <ComponentRef Id="ExtXml" />
        <ComponentRef Id="ExtSh" />
      </Feature>
    </Feature>
    <!-- The setup UI. Two pages of our own, then the UI extension's stock
         ProgressDlg/CancelDlg/ErrorDlg/UserExit.

         Why not the extension's ExitDialog: in WiX 7 its dialog ships with no
         ControlEvent rows at all (verified by querying the built MSI), so its
         Finish button does nothing and the wizard can never be closed - it had
         to be killed from Task Manager. The completion page below is ours so
         the Finish button's EndDialog is guaranteed to exist.

         Why every control names a TextStyle: an unset TextStyle falls back to
         Windows Installer's legacy 8pt raster face, which is what made the old
         pages look blocky on a modern display.

         Why the text is ASCII: dialog strings are rendered in the package's
         language codepage, which rewrites anything else (an em dash came out
         as "I", smart quotes as "IOpen withl"). -->
    <!-- WiX v4+ has no per-control TextStyle attribute, so the face comes from
         DefaultUIFont: Windows Installer applies the named style to every
         control whose TextStyle is empty - all of ours, and the imported
         dialogs' too. Without it the legacy raster face comes back, which is
         what made the old pages look blocky. -->
    <Property Id="DefaultUIFont" Value="EditorBody" />

    <!-- Add/Remove Programs metadata: what the Windows "Installed apps" page
         shows next to the name. -->
    <Property Id="ARPCOMMENTS" Value="Viewer and editor for Markdown, JSON, CSV, logs and code." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Eric-Lautanen/editor" />

    <!-- The installer's choices. All three default to 1, so Install takes
         everything with no clicks beyond the button; a silent install runs no
         UI and lands on the feature defaults, which is what the auto-updater
         must produce. -->
    <Property Id="DOCUMENT_TYPES" Value="1" />
    <Property Id="CODE_TYPES" Value="1" />
    <Property Id="DESKTOP_SHORTCUT" Value="1" />
    <UI Id="EditorOnePageUi">
      <TextStyle Id="EditorBody" FaceName="Segoe UI" Size="9" />
      <Dialog Id="EditorWelcomeDlg" Width="370" Height="270" Title="Install Editor">
        <Control Id="AppIcon" Type="Icon" X="18" Y="10" Width="32" Height="32" Text="editor_setup.ico" />
        <Control Id="Title" Type="Text" X="58" Y="12" Width="294" Height="18" Transparent="yes" NoPrefix="yes" Text="Install Editor" />
        <Control Id="Subtitle" Type="Text" X="58" Y="32" Width="294" Height="12" Transparent="yes" NoPrefix="yes" Text="Native viewer and editor for Markdown, JSON, CSV, logs and code." />
        <Control Id="HeaderLine" Type="Line" X="0" Y="54" Width="370" Height="0" />
        <!-- The section heading states the action once, so each checkbox only
             has to name its group. Each is one line with its extension list
             under it: one long wrapped line would clip (it did - the old page
             cut the list off mid-word). Height 10 is a single 9pt line. -->
        <Control Id="AssocSection" Type="Text" X="18" Y="66" Width="334" Height="12" Transparent="yes" NoPrefix="yes" Text="Add Editor to the Open with menu for" />
        <Control Id="DocumentsCheck" Type="CheckBox" X="18" Y="84" Width="336" Height="10" Property="DOCUMENT_TYPES" CheckBoxValue="1" Text="Documents and config files" />
        <!-- Single-space separators, not the double spaces these lists used to
             carry: fifteen names double-spaced ran to within 5px of this
             control's right edge at 100% scaling, measured from a capture of
             the built MSI's own dialog, which is one font metric away from the
             mid-word clip this page has already been through once. -->
        <Control Id="DocumentsList" Type="Text" X="36" Y="96" Width="318" Height="10" Transparent="yes" NoPrefix="yes" Text="md markdown json jsonl ndjson txt log csv tsv yaml yml toml ini cfg conf" />
        <Control Id="CodeCheck" Type="CheckBox" X="18" Y="114" Width="336" Height="10" Property="CODE_TYPES" CheckBoxValue="1" Text="Code and markup files" />
        <Control Id="CodeList" Type="Text" X="36" Y="126" Width="318" Height="10" Transparent="yes" NoPrefix="yes" Text="rs py js ts c h cpp hpp cs java go rb php css html xml sh" />
        <Control Id="ShortcutSection" Type="Text" X="18" Y="146" Width="334" Height="12" Transparent="yes" NoPrefix="yes" Text="Shortcuts" />
        <Control Id="DesktopCheck" Type="CheckBox" X="18" Y="164" Width="336" Height="10" Property="DESKTOP_SHORTCUT" CheckBoxValue="1" Text="Create a shortcut on the Desktop" />
        <Control Id="StartMenuNote" Type="Text" X="36" Y="175" Width="318" Height="10" Transparent="yes" NoPrefix="yes" Text="A Start menu entry is always added." />
        <Control Id="Note" Type="Text" X="18" Y="194" Width="334" Height="34" Transparent="yes" NoPrefix="yes" Text="Editor only joins the Open with menu - your current default apps are not changed. Run the installer again to change these choices." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <!-- The checkbox pattern: the check state lands in the property
             (CheckBoxValue) and these events turn it into feature state.
             Unchecked -> Remove (absent); checked -> AddLocal (installed). -->
        <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Install">
          <Publish Event="AddLocal" Value="DocumentTypes" Condition="DOCUMENT_TYPES" Order="1" />
          <Publish Event="Remove" Value="DocumentTypes" Condition="NOT DOCUMENT_TYPES" Order="2" />
          <Publish Event="AddLocal" Value="CodeTypes" Condition="CODE_TYPES" Order="3" />
          <Publish Event="Remove" Value="CodeTypes" Condition="NOT CODE_TYPES" Order="4" />
          <Publish Event="AddLocal" Value="DesktopShortcutFeature" Condition="DESKTOP_SHORTCUT" Order="5" />
          <Publish Event="Remove" Value="DesktopShortcutFeature" Condition="NOT DESKTOP_SHORTCUT" Order="6" />
          <Publish Event="EndDialog" Value="Return" Order="7" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <Dialog Id="EditorDoneDlg" Width="370" Height="270" Title="Editor Setup Complete">
        <Control Id="AppIcon" Type="Icon" X="18" Y="10" Width="32" Height="32" Text="editor_setup.ico" />
        <Control Id="Title" Type="Text" X="58" Y="12" Width="294" Height="18" Transparent="yes" NoPrefix="yes" Text="Setup complete" />
        <Control Id="Subtitle" Type="Text" X="58" Y="32" Width="294" Height="12" Transparent="yes" NoPrefix="yes" Text="Editor [ProductVersion] is installed for your account." />
        <Control Id="HeaderLine" Type="Line" X="0" Y="54" Width="370" Height="0" />
        <Control Id="Body" Type="Text" X="18" Y="68" Width="334" Height="40" Transparent="yes" NoPrefix="yes" Text="Open a file from the Open with menu, or drag it onto the Editor window. Editor is in the Start menu too." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="Back" />
        <!-- The one event that matters: this is what the extension's page was
             missing, so Finish now closes the wizard. -->
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finish">
          <Publish Event="EndDialog" Value="Return" Order="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="Cancel" />
      </Dialog>
      <InstallUISequence>
        <Show Dialog="EditorWelcomeDlg" Before="ExecuteAction" />
        <!-- OnExit="success" is the MSI exit-page slot (the -1 row); only a
             fresh install gets a completion page, since `Installed` is already
             set during a repair or an uninstall and "Setup complete" would be
             a lie there. -->
        <Show Dialog="EditorDoneDlg" OnExit="success" Condition="NOT Installed" />
      </InstallUISequence>
      <!-- The stock progress page (its Cancel event is intact, and the UI
           sequence drives its controls), plus the cancel/error/abort pages. -->
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="ErrorDlg" />
      <!-- Maintenance mode (repair/change/uninstall over an existing install)
           needs no page; Windows Installer's own dialogs handle it. -->
    </UI>

    <!-- `PerUserProgramFilesFolder` (WiX v6+): resolves to
         %LOCALAPPDATA%\Programs in per-user scope. Plain
         `ProgramFiles64Folder` does NOT redirect and dies with error 1303
         against the real Program Files — verified the hard way. -->
    <StandardDirectory Id="PerUserProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="Editor">
        <Component Id="AppExe" Guid="*">
          <File Id="EditorExe" Source="$(var.PublishDir)\editor.exe" KeyPath="yes" />
          <!-- Uninstall must leave nothing behind, including this folder:
               without RemoveFolder the directory survives its contents (the
               exe and the Start-menu dir go, the empty Programs\Editor shell
               stayed, confirmed by a real uninstall cycle). -->
          <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        </Component>

        <!-- Editor.Document: name, icon, and the open command the shell runs
             when the user picks Editor as the default for a type. -->
        <Component Id="ProgIdRegistry" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\Editor.Document">
            <RegistryValue Type="string" Value="Editor Document" KeyPath="yes" />
          </RegistryKey>
          <RegistryKey Root="HKCU" Key="Software\Classes\Editor.Document\DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]editor.exe,0" />
          </RegistryKey>
          <RegistryKey Root="HKCU" Key="Software\Classes\Editor.Document\shell\open\command">
            <!-- The quoting is load-bearing: the exe path may contain spaces
                 (`%LOCALAPPDATA%\Programs` can appear verbatim) and so may
                 the opened file's path. -->
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]editor.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </Component>

        <!-- One component per extension, because an MSI component may
             carry exactly one KeyPath and each HKCU key wants to be its
             own. Mirrors `platform/install.rs` /
             `core::file_kind::EXTENSIONS`; update both when the list moves.
             Installation is "offer, don't take": placement only adds Editor
             to the Explorer "Open with" menu, never clobbers the user's
             existing default. -->

        <Component Id="ExtMd" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.md\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtMarkdown" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.markdown\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtJson" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.json\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtJsonl" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.jsonl\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtNdjson" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.ndjson\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtTxt" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.txt\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtLog" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.log\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtCsv" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.csv\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtTsv" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.tsv\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtYaml" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.yaml\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtYml" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.yml\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtToml" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.toml\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtIni" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.ini\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtCfg" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.cfg\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtConf" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.conf\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtRs" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.rs\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtPy" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.py\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtJs" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.js\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtTs" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.ts\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtC" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.c\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtH" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.h\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtCpp" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.cpp\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtHpp" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.hpp\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtCs" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.cs\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtJava" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.java\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtGo" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.go\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtRb" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.rb\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtPhp" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.php\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtCss" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.css\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtHtml" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.html\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtXml" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.xml\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="ExtSh" Guid="*">
          <RegistryKey Root="HKCU" Key="Software\Classes\.sh\OpenWithProgids">
            <RegistryValue Name="Editor.Document" Type="string" Value="" KeyPath="yes" />
          </RegistryKey>
        </Component>      </Directory>
    </StandardDirectory>

    <!-- The Desktop shortcut. Same per-user KeyPath trick as the Start menu
         component below (an HKCU value, since a per-user component's key path
         cannot be a machine-context shortcut), and the .lnk itself is removed
         with the component on uninstall. The Desktop *folder* is not ours, so
         there is deliberately no RemoveFolder here. -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut
            Id="EditorDesktopShortcut"
            Name="Editor"
            Description="Editor - native viewer for Markdown, JSON, CSV and code"
            Target="[INSTALLFOLDER]editor.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="editor.ico" />
        <RegistryValue Root="HKCU" Key="Software\Eric-Lautanen\Editor" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Editor">
        <!-- Shortcuts need a KeyPath of their own; an HKCU registry value is
             the per-user MSI-correct one (a shortcut file would need machine
             context). Removing the value plus the folder makes uninstall
             leave nothing behind. -->
        <Component Id="StartMenuShortcut" Guid="*">
          <!-- ASCII, like the dialog text: Windows Installer writes a shortcut
               description through the shell, which turned the em dash this
               once carried into a plain hyphen anyway (checked by reading both
               .lnk files after a real install). -->
          <Shortcut
              Id="EditorShortcut"
              Name="Editor"
              Description="Editor - native viewer for Markdown, JSON, CSV and code"
              Target="[INSTALLFOLDER]editor.exe"
              WorkingDirectory="INSTALLFOLDER"
              Icon="editor.ico" />
          <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Eric-Lautanen\Editor" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
