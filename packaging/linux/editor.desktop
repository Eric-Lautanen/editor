[Desktop Entry]
Type=Application
Name=Editor
Comment=Read and lightly edit Markdown, JSON, CSV, configs, logs and code
Exec=editor %f
Icon=editor
Terminal=false
Categories=Utility;TextEditor;Viewer;
MimeType=text/markdown;application/json;application/x-ndjson;text/plain;text/csv;text/x-yaml;application/toml;text/x-editor-dotfile;
